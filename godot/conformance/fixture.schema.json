        {
          "not": {
            "anyOf": [
              { "properties": { "marginal": {} }, "required": ["marginal"] },
              { "properties": { "mechanism": {} }, "required": ["mechanism"] }
            ]
          }
        }
      ]
    },
    {
      "if": {
        "properties": { "tier": { "const": "C2" } },
        "required": ["tier"]
      },
      "then": {
        "required": ["digest"],
        "properties": { "digest": {} }
      },
      "else": {
        "not": {
          "properties": { "digest": {} },
          "required": ["digest"]
        }
      }
    }
