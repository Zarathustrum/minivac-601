        { "contains": { "$ref": "#/$defs/obsOutLamp3" }, "minContains": 0, "maxContains": 1 },
        { "contains": { "$ref": "#/$defs/obsOutLamp4" }, "minContains": 0, "maxContains": 1 },
        { "contains": { "$ref": "#/$defs/obsOutLamp5" }, "minContains": 0, "maxContains": 1 },
        { "contains": { "$ref": "#/$defs/obsOutLamp6" }, "minContains": 0, "maxContains": 1 },
        { "contains": { "$ref": "#/$defs/obsIndLamp1" }, "minContains": 0, "maxContains": 1 },
        { "contains": { "$ref": "#/$defs/obsIndLamp2" }, "minContains": 0, "maxContains": 1 },
        { "contains": { "$ref": "#/$defs/obsIndLamp3" }, "minContains": 0, "maxContains": 1 },
        { "contains": { "$ref": "#/$defs/obsIndLamp4" }, "minContains": 0, "maxContains": 1 },
        { "contains": { "$ref": "#/$defs/obsIndLamp5" }, "minContains": 0, "maxContains": 1 },
        { "contains": { "$ref": "#/$defs/obsIndLamp6" }, "minContains": 0, "maxContains": 1 }
      ]
    },
    "sourceText": { "type": "string", "minLength": 1, "pattern": "^[^\\u0000-\\u001f]*$" },
    "fallbackSource": { "type": "string", "pattern": "^FALLBACK-[A-Z0-9]+(?:-[A-Z0-9]+)*$" },
    "fallbackProvenance": {
      "type": "object",
      "oneOf": [
        {
          "properties": { "tag": {}, "source": {} },
          "required": ["tag", "source"]
        },
        {
          "not": {
            "anyOf": [
              { "properties": { "tag": {} }, "required": ["tag"] },
              { "properties": { "source": {} }, "required": ["source"] }
            ]
          }
        }
      ]
    },
    "untilStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["k", "obs", "maxMs", "cite", "quote"],
      "properties": {
        "k": { "const": "until" },
        "obs": { "$ref": "#/$defs/observableList" },
        "maxMs": { "$ref": "#/$defs/positiveInt32" },
        "cite": { "$ref": "#/$defs/sourceText" },
        "quote": { "$ref": "#/$defs/sourceText" },
        "tag": { "const": "unverified" },
        "source": { "$ref": "#/$defs/fallbackSource" }
      },
      "allOf": [{ "$ref": "#/$defs/fallbackProvenance" }]
    },
    "expectStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["k", "obs", "cite", "quote"],
      "properties": {
        "k": { "const": "expect" },
        "obs": { "$ref": "#/$defs/observableList" },
        "cite": { "$ref": "#/$defs/sourceText" },
        "quote": { "$ref": "#/$defs/sourceText" },
        "tag": { "const": "unverified" },
        "source": { "$ref": "#/$defs/fallbackSource" }
      },
      "allOf": [{ "$ref": "#/$defs/fallbackProvenance" }]
    }
  }
}
